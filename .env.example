# Real-endpoint bridge verification (scripts/probe_bridge_env.py).
# Copy to .env and fill in; never commit the real .env.

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Optional overrides:
# PROBE_MODEL=gpt-4o-mini
# PROBE_LAYER=1        # 1 | 2 | 3 | all
# PROBE_TIMEOUT=180

# Optional: real hot path (docker run -p 6379:6379 redis:7)
# REDIS_URL=redis://localhost:6379/0

# ---- gateway (n8n bridge demo) ---------------------------------------------
# `uvicorn ... --factory` reads this same repo-root .env (process env
# always wins over .env values). Only GATEWAY_AUTH_TOKEN is required;
# everything below derives from the section above when unset:
#   redis:    GATEWAY_REDIS_URL, else REDIS_URL
#   endpoint: OPENAI_BASE_URL / OPENAI_API_KEY (OPENAI_API_BASE alias)
#   model:    GATEWAY_MODEL_CLIENTS, else one "research" client on
#             PROBE_MODEL over the built-in "llm" semaphore resource

GATEWAY_AUTH_TOKEN=dev-token
# GATEWAY_TRACE_ROOT=data/gateway-runs
# GATEWAY_REDIS_URL=redis://localhost:6379/0
# GATEWAY_REGISTRY_MODULE=examples.gateway_n8n.registry:build_registry

# Demo registry client vocabulary (examples/gateway_n8n): the impls
# call THREE client names -- research / writing / publish. The default
# derivation only creates "research", so the demo narrative fails with
# "unknown llm client 'writing'" unless all three are declared here.
# They may share one model and one semaphore resource; the semaphore
# table must contain that resource plus the built-in names (one
# namespace for resources and semaphores, docs/pitfalls.md 2).
# GATEWAY_MODEL_CLIENTS={"research":{"model":"gpt-4o-mini","resource":"llm"},"writing":{"model":"gpt-4o-mini","resource":"llm"},"publish":{"model":"gpt-4o-mini","resource":"llm"}}
# GATEWAY_SEMAPHORES={"task_execution":8,"llm":4,"web_search":2,"memo_store":2}
# GATEWAY_BUDGET_MAX_UNITS=100000